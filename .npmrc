# ==============================================================================
# .npmrc - Políticas de Seguridad y Dependencias en GUACHAFIT
# ==============================================================================

# 1. SEGURIDAD ESTRICTA ANTI-MALWARE:
# Bloquea la ejecución automática de scripts 'preinstall', 'install' y 'postinstall'
# procedentes de dependencias externas. Esto previene ataques de cadena de suministro (supply-chain attacks).
# Si un paquete de confianza requiere compilar binarios (ej. esbuild, sharp),
# se debe autorizar explícitamente mediante 'pnpm approve-builds' o 'pnpm rebuild'.
ignore-scripts=true

# 2. RESOLUCIÓN DE DEPENDENCIAS EN MONOREPO:
auto-install-peers=true
strict-peer-dependencies=false
link-workspace-packages=true

# 3. GESTIÓN DE HOISTING Y ALMACENAMIENTO:
shamefully-hoist=false
prefer-frozen-lockfile=true
