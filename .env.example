# ==============================================================================
# GUACHAFIT - Entorno de Desarrollo Local
# ==============================================================================

# Base de Datos (PostgreSQL 16)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/guachafit"

# Redis (BullMQ / Caché)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Autenticación y Seguridad
# En producción son OBLIGATORIAS y deben ser distintas entre sí: si faltan o conservan
# un valor de ejemplo, el API no arranca. Genéralas con: openssl rand -hex 48
JWT_SECRET="super-secret-jwt-key-for-local-dev-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-key-for-local-dev-min-32-chars"
JWT_EXPIRES_IN="7d"

# Proxy inverso (OBLIGATORIA detrás de Cloudflare / Coolify)
# Número de proxies delante del API (p. ej. 2 = Cloudflare + proxy de Coolify) o lista
# de IPs/subredes. Vacío = desactivado: todos los usuarios compartirían la IP del proxy
# y el límite de intentos de login los bloquearía juntos.
TRUST_PROXY=

# Almacenamiento de Archivos (MinIO / Emulación Cloudflare R2)
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="guachafit-r2-local"
STORAGE_REGION="auto"

# Criptografía (AES-256-GCM para Fichas de Salud Privadas)
ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Configuración de Servidor
PORT=3000
NODE_ENV="development"

# Cobranza / Bull-Board (RF-008)
BULL_BOARD_USER=panel
BULL_BOARD_PASS=cambia_esta_clave
COBRANZA_BARRIDO_CRON=0 9 * * *

# Resumen semanal del coach (RF-014)
RESUMEN_SEMANAL_CRON=0 8 * * 1

# Correo transaccional con Brevo (ADR-018)
# Sin BREVO_API_KEY (o sin EMAIL_REMITENTE) los correos solo se simulan en el log.
# El remitente debe pertenecer a un dominio verificado en Brevo (SPF/DKIM/DMARC).
BREVO_API_KEY=
EMAIL_REMITENTE="no-responder@tu-dominio.com"
EMAIL_REMITENTE_NOMBRE="GUACHAFIT"

# URL pública de la web, usada para construir los enlaces de los correos
# (activación y recuperación de contraseña). En producción: https://app.tu-dominio.com
APP_URL="http://localhost:3000"

# Solo para tests automatizados: desactiva el límite de intentos (se ignora si
# NODE_ENV no es "test"). No lo definas en desarrollo ni en producción.
# LIMITE_INTENTOS_DESACTIVADO=true
