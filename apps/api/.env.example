# ==============================================================================
# GUACHAFIT - API Backend Local Environment Variables
# ==============================================================================

# Database
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/guachafit"

# Redis (BullMQ / In-Memory Cache)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Auth / Security
# Vacíos = desarrollo: el API usa los secretos de desarrollo integrados.
# En producción son OBLIGATORIOS y distintos entre sí; si faltan, el API no arranca.
# Genéralos con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN="7d"

# Storage (MinIO S3 / Cloudflare R2 Mock)
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="guachafit-r2-local"
STORAGE_REGION="auto"

# Encryption (AES-256-GCM - Medical records / RF-003 & RNF-003)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Server Port
PORT=4000
NODE_ENV="development"

# Cobranza / Bull-Board (RF-008)
BULL_BOARD_USER=panel
BULL_BOARD_PASS=cambia_esta_clave
COBRANZA_BARRIDO_CRON=0 9 * * *

# Resumen semanal del coach (RF-014)
RESUMEN_SEMANAL_CRON=0 8 * * 1
